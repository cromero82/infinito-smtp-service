# Local environment variables for smtp-service (do NOT commit real secrets)
# Copy this file to .env and fill in your values. The app will auto-load .env if present.

# SMTP provider (Gmail defaults shown)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=romeromailercarlos@gmail.com
# App Password from Google (16 chars, NO spaces)
SPRING_MAIL_PASSWORD=replace_with_your_app_password

# Alternatively you can use these names instead of SPRING_MAIL_PASSWORD
# SMTP_PASSWORD=
# MAIL_PASSWORD=

SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=romeromailercarlos@gmail.com

# Optional debug
# SMTP_MAIL_DEBUG=true